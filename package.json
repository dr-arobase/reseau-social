{
  "name": "a-propos-social",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "dev": "concurrently -k -n vite,electron \"vite\" \"wait-on http://localhost:5173 && electron . --dev\"",
    "dev:web": "concurrently -k -n api,vite \"node --watch server/index.js\" \"vite\"",
    "build": "vite build",
    "start": "vite build && electron .",
    "api": "node server/index.js",
    "test": "node --test tests/api.test.js",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:seed": "node prisma/seed.js",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@prisma/client": "^6.17.0",
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^17.2.2",
    "express": "^5.1.0",
    "express-rate-limit": "^8.7.1",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.4.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.0.2",
    "concurrently": "^9.2.1",
    "electron": "^38.2.0",
    "prisma": "^6.17.0",
    "vite": "^7.1.7",
    "wait-on": "^8.0.4"
  }
}
